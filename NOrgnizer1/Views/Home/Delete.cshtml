
@model Zadanie


<h3>Czy na pewno chcesz usunąć to zadanie?</h3>
<div>
    <h4>Zadanie</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Waznosc</dt>
        <dd class="col-sm-10">@Model.Waznosc</dd>
        <dt class="col-sm-2">Grupa</dt>
        <dd class="col-sm-10">@Model.Grupa</dd>
        <dt class="col-sm-2">Data wykonania</dt>
        <dd class="col-sm-10">@Model.DataWykonania?.ToShortDateString()</dd>
        <dt class="col-sm-2">Data przypomnienia</dt>
        <dd class="col-sm-10">@Model.DataPrzypomnienia?.ToShortDateString()</dd>
        <dt class="col-sm-2">Data zakończenia</dt>
        <dd class="col-sm-10">@Model.DataZakonczenia?.ToShortDateString()</dd>
    </dl>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit">Usuń</button>
    <a asp-action="Index">Anuluj</a>
</form>

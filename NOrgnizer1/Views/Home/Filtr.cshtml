@model IEnumerable<Zadanie>

@{
    ViewData["Title"] = "Lista zadań";
}

<h1>@ViewData["Title"]</h1>

<form method="get" asp-action="Filtr">
    <div class="form-group">
        <label for="grupa">Grupa</label>
        <select id="grupa" name="grupa" class="form-control">
            <option value="">Wybierz grupę</option>
            <!-- Można tu dodać dostępne grupy z bazy -->
            <option value="1">Grupa 1</option>
            <option value="2">Grupa 2</option>
            <option value="3">Grupa 3</option>
        </select>
    </div>

    <div class="form-group">
        <label for="waznosc">Ważność</label>
        <select id="waznosc" name="waznosc" class="form-control">
            <option value="">Wybierz ważność</option>
            <option value="1">Niska</option>
            <option value="2">Średnia</option>
            <option value="3">Wysoka</option>
        </select>
    </div>

    <div class="form-group">
        <label for="dataWykonania">Data wykonania</label>
        <input type="date" id="dataWykonania" name="dataWykonania" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Filtruj</button>
</form>

<hr />

<h3>Lista zadań</h3>

<table class="table">
    <thead>
        <tr>
            <th>Grupa</th>
            <th>Ważność</th>
            <th>Data wykonania</th>
            <th>Data przypomnienia</th>
            <th>Data zakończenia</th>
            <th>Treść</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var zadanie in Model)

        {
            <tr>
                <td>@zadanie.Grupa</td>
                <td>@zadanie.Waznosc</td>
                <td>@zadanie.DataWykonania?.ToString("yyyy-MM-dd")</td>
                <td>@zadanie.DataPrzypomnienia?.ToString("yyyy-MM-dd")</td>
                <td>@zadanie.DataZakonczenia?.ToString("yyyy-MM-dd")</td>
                <td>@zadanie.Tresc</td>
            </tr>
        }
    </tbody>
</table>
